# NextAuth
# IMPORTANTE: 
# - Para desenvolvimento local, use: http://localhost:3000
# - Para produção (Netlify), configure no painel do Netlify:
#   NEXTAUTH_URL=https://letracerta.netlify.app
#   OU deixe em branco para detecção automática (o sistema usa a variável URL do Netlify)
NEXTAUTH_URL=http://localhost:3000
# Em produção no Netlify, configure: NEXTAUTH_URL=https://letracerta.netlify.app
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Google OAuth
# IMPORTANTE: Configure os URIs de redirecionamento no Google Cloud Console:
# - http://localhost:3000/api/auth/callback/google (desenvolvimento)
# - https://letracerta.netlify.app/api/auth/callback/google (produção)
# Veja CONFIGURAR_GOOGLE_OAUTH.md para instruções detalhadas
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

